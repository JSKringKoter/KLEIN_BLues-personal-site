<style is:global>
  .tb-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .tb-sprite symbol,
  .tb-i {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tb-sprite .solid {
    fill: currentColor;
    stroke: none;
  }

  .tb-i {
    display: inline-block;
    flex: none;
    width: 1em;
    height: 1em;
    vertical-align: -0.14em;
    overflow: visible;
  }
</style>

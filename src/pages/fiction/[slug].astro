---
import { getCollection, type CollectionEntry } from "astro:content";
import DeepBlueOrnaments from "../../components/DeepBlueOrnaments.astro";
import NovelBody from "../../components/NovelBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { parseNovelDocument } from "../../lib/novel";

export async function getStaticPaths() {
  const works = await getCollection("fiction");
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work, totalWorks: works.length }
  }));
}

interface Props {
  work: CollectionEntry<"fiction">;
  totalWorks: number;
}

const { work, totalWorks } = Astro.props;
// 挂在本篇末尾的番外（未删减片段、后日谈）
const extras = (await getCollection("extras", (extra) => extra.data.parent === work.id)).sort((a, b) => a.data.order - b.data.order);
const extraColors = ["#8a5c28", "#283f66", "#633e6b"];
const document = parseNovelDocument(work.body ?? "", work.data.title);
const canonicalPath = `/fiction/${work.id}/`;
// 社交平台不显示 SVG：SVG 封面改用 npm run images 生成的同名 .og.jpg
const socialImage = work.data.cover.replace(/\.svg$/, ".og.jpg");
const pageTitle = `《${work.data.title}》 | KLEIN BLues`;
const workPosition = `${String(work.data.order).padStart(2, "0")} / ${String(totalWorks).padStart(2, "0")}`;
---

<BaseLayout
  title={pageTitle}
  description={work.data.excerpt}
  canonicalPath={canonicalPath}
  image={socialImage}
  type="article"
  handoff={{ from: "fiction", kind: "fiction", theme: work.data.theme, title: work.data.title }}
>
  <main class:list={["fiction-reader", `theme-${work.data.theme}`]} data-reader>
    <div class="reader-backdrop" aria-hidden="true"></div>
    {work.data.theme === "deepblue" && <DeepBlueOrnaments />}

    <header class="reader-toolbar" data-handoff-part>
      <a href="/#fiction" aria-label="返回一纸空文" data-cursor="BACK" data-handoff-back>
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M25 16H7m7-7-7 7 7 7" /></svg>
        <span>返回目录</span>
      </a>
    </header>

    {document.headings.length > 0 && (
      <nav class="reader-toc" aria-label="文章章节" data-handoff-part style="--part:4">
        {document.headings.map((heading, index) => (
          <a href={`#${heading.id}`} class:list={[index === 0 && "is-active"]} data-chapter-link={heading.id} data-cursor="GO">
            <strong>{heading.title}</strong>
          </a>
        ))}
      </nav>
    )}

    <article class="reader-sheet">
      <header class="reader-title-block">
        <p data-handoff-part style="--part:1">{workPosition} · {work.data.charCount.toLocaleString("zh-CN")} 字</p>
        <h1 data-handoff-target>{work.data.title}</h1>
        <p class="reader-subtitle" data-handoff-part style="--part:2">{work.data.subtitle}</p>
        {work.data.publication.length > 0 && (
          <dl class="reader-publication" data-handoff-part style="--part:3">
            {work.data.publication.map((item) => (
              <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
            ))}
          </dl>
        )}
      </header>

      <div class="reader-body" data-handoff-part style="--part:5">
        <NovelBody blocks={document.blocks} />
      </div>

      {extras.length > 0 && (
        <section class="reader-extras" id="extras" aria-labelledby="extrasTitle" data-handoff-part style="--part:6">
          <header>
            <h2 id="extrasTitle">未删减片段与后日谈</h2>
            <p>如果你相信故事已经停在那个深秋，请合上书页；如果你觉得故事仍留有遗憾，就继续往下读吧。</p>
          </header>
          <div class="reader-extra-list">
            {extras.map((extra, index) => (
              <a
                class="reader-extra-row"
                href={`/fiction/${work.id}/${extra.id}/`}
                data-extra-row
                data-title={extra.data.title}
                data-theme={work.data.theme}
                data-cursor="ENTER"
                style={`--row-color:${extraColors[index % extraColors.length]};--row-cover:url("${work.data.cover}")`}
              >
                <span class="reader-extra-no">{String(index + 1).padStart(2, "0")}</span>
                <h3>《<span data-handoff-title={extra.data.title}>{extra.data.title}</span>》</h3>
                <small>{extra.data.charCount.toLocaleString("zh-CN")} 字</small>
                <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 25 25 7M12 7h13v13" /></svg>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>

  <script>
    import { setupTitleFit } from "../../scripts/title-fit";
    import { setupExtraLinks } from "../../scripts/extra-links";
    setupTitleFit();
    setupExtraLinks();

    const chapterLinks = Array.from(document.querySelectorAll("[data-chapter-link]"));
    const chapters = Array.from(document.querySelectorAll("[data-chapter]"));

    const activateChapter = (id: string) => {
      chapterLinks.forEach((link) => link.classList.toggle("is-active", link.getAttribute("data-chapter-link") === id));
    };

    if (chapters.length) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) activateChapter(visible[0].target.id);
      }, { rootMargin: "-15% 0px -72% 0px", threshold: 0 });
      chapters.forEach((chapter) => observer.observe(chapter));
    }

  </script>
</BaseLayout>

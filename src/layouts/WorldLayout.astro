---
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  variant?: "portraits" | "sky" | "built" | "design";
}
const { title, description, canonicalPath, variant = "sky" } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const socialImage = new URL("/assets/images/social/kleinblues-og-v2.jpg", Astro.site);
const index = {
  sky: { label: "01 / THE UNIVERSE", href: "/worldbuildings/the-built/", text: "《构界》 ↗" },
  built: { label: "02 / THE BUILT", href: "/worldbuildings/game-design/", text: "核心战机 ↗" },
  design: { label: "03 / GAME DESIGN", href: "/worldbuildings/portraits/", text: "画中人 ↗" },
  portraits: { label: "03 / ORIGINAL CHARACTERS", href: "/worldbuildings/cangqiong/", text: "苍穹 ↗" },
}[variant];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={variant === "sky" ? "#eef1f6" : variant === "design" ? "#eef2fb" : variant === "built" ? "#eef2fb" : "#f3efe8"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KLEIN BLues" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ variant }}>
      // 从首页点进来：先铺一层与首页离场终点同色的幕布，再慢慢揭开
      try {
        if (sessionStorage.getItem("kb-veil") === variant) {
          sessionStorage.removeItem("kb-veil");
          document.documentElement.classList.add("kb-veiled");
        }
      } catch {}
    </script>
    <link rel="stylesheet" href="/styles.css?v=72" />
    <link rel="stylesheet" href="/worldbuildings.css?v=4" />
    <style is:global>
      /* 与首页世界观模块离场终点（stage.css 的 .wl-veil）和交接层（handoff.css）同色 */
      .kb-veil {
        display: none;
        position: fixed;
        z-index: 1200;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(120% 95% at 60% 40%, #f7f8fb 0%, #d9dfec 100%);
      }

      .world-page-design .kb-veil {
        background: #eef2fb;
      }

      .world-page-built .kb-veil {
        background: #eef2fb;
      }

      .world-page-portraits .kb-veil {
        background: #efeae2;
      }

      html.kb-veiled .kb-veil,
      html.kb-reveil .kb-veil {
        display: block;
      }

      html.kb-unveil .kb-veil {
        opacity: 0;
        transition: opacity 1.4s cubic-bezier(0.4, 0, 0.2, 1) 0.15s;
      }

      /* 返回首页：幕布重新铺满，首页由对应的模块接住（src/scripts/handoff.ts） */
      html.kb-reveil .kb-veil {
        opacity: 0;
        animation: kb-reveil 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      }

      @keyframes kb-reveil {
        to {
          opacity: 1;
        }
      }
    </style>
  </head>
  <body class:list={["world-page", `world-page-${variant}`, "world-page-light"]}>
    <div class="noise" aria-hidden="true"></div>
    <div class="cursor" id="cursor" aria-hidden="true"><span></span><i></i><i></i><i></i><i></i></div>
    <header class="masthead world-masthead" id="masthead">
      <a class="wordmark" href="/" aria-label="返回首页" data-cursor="HOME"><strong>KLEIN</strong><span>BLues</span></a>
      <a class="world-back" href={variant === "portraits" ? "/#portraits" : "/#worldbuildings"} data-cursor="BACK"><span aria-hidden="true">←</span> WORLDBUILDINGS</a>
      <a class="world-page-index world-page-next" href={index.href} data-cursor="ENTER"><span>{index.label}</span><b>{index.text}</b></a>
    </header>
    <main id="app"><slot /></main>
    <div class="kb-veil" aria-hidden="true"></div>
    <script is:inline>
      if (document.documentElement.classList.contains("kb-veiled")) {
        requestAnimationFrame(() => requestAnimationFrame(() => document.documentElement.classList.add("kb-unveil")));
      }
    </script>
    <script is:inline define:vars={{ variant }}>
      // 返回首页：幕布铺满后再跳转，并留下接力信息（格式见 src/scripts/handoff.ts）
      document.querySelectorAll(".world-back, .world-masthead .wordmark").forEach((link) => {
        link.addEventListener("click", (event) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          const html = document.documentElement;
          if (html.classList.contains("kb-reveil")) return;
          const back = link.classList.contains("world-back");
          const from = !back ? "home" : variant === "portraits" ? "portraits" : "worlds";
          try {
            sessionStorage.setItem("kb-handoff", JSON.stringify({ to: "/", from, kind: variant, path: location.pathname, t: Date.now() }));
          } catch {}
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          html.classList.remove("kb-veiled", "kb-unveil");
          html.classList.add("kb-reveil");
          setTimeout(() => location.assign(link.href), reduce ? 0 : 620);
        });
      });
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) document.documentElement.classList.remove("kb-reveil");
      });
    </script>
    <slot name="overlays" />
    <slot name="scripts" />
    {
      variant !== "portraits" && (
        <script>
          import { setupSiteCursor } from "../scripts/site-cursor";
          setupSiteCursor();
        </script>
      )
    }
  </body>
</html>
